---
import { links } from '../../data/links';
import { profile } from '../../data/profile';
import SectionFrame from './SectionFrame.astro';
import TerminalTypewriter from './TerminalTypewriter.astro';

const contactLinks = [
  { label: 'GitHub', href: links.github, value: links.github.replace('https://', '') },
  { label: 'Blog', href: links.blog, value: links.blog.replace('https://', '') },
  { label: 'Email', href: links.email, value: links.email.replace('mailto:', '') },
  { label: 'Resume', href: links.resume, value: 'Download dossier extract' }
];

const profileFacts = [
  { label: 'File No.', value: profile.fileNumber },
  { label: 'Clearance', value: profile.clearance },
  { label: 'Status', value: profile.status },
  { label: 'Location', value: profile.location },
  { label: 'Track', value: profile.track },
  { label: 'Verification', value: profile.verification }
];
---

<SectionFrame
  eyebrow={profile.fileLabel}
  title={profile.title}
  stamp={profile.access}
  class="min-h-[calc(100vh-4rem)] content-center"
>
  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.85fr)]">
    <div class="space-y-8">
      <div class="space-y-5">
        <div class="space-y-2">
          <p class="dossier-kicker">Subject // {profile.subject}</p>
          <h1 class="dossier-title text-[clamp(2.6rem,6vw,4.6rem)]">{profile.subject}</h1>
        </div>

        <div class="space-y-2">
          <p class="text-lg uppercase tracking-[0.22em] text-dossier-paper">{profile.role}</p>
          <p class="text-sm uppercase tracking-[0.18em] text-dossier-muted">{profile.focus}</p>
        </div>

        <p class="dossier-lede max-w-3xl">{profile.summary}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {profileFacts.map((fact) => (
          <div class="border border-dossier-line/60 bg-dossier-panel/35 px-4 py-4">
            <p class="dossier-kicker">{fact.label}</p>
            <p class="mt-3 text-sm uppercase tracking-[0.12em] text-dossier-paper">{fact.value}</p>
          </div>
        ))}
      </div>

      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
        <div class="border border-dossier-line/60 bg-dossier-panel/30 p-4">
          <p class="dossier-kicker">Education Record</p>
          <div class="mt-4 space-y-3 text-sm text-dossier-muted">
            <p class="text-base uppercase tracking-[0.12em] text-dossier-paper">
              {profile.education.institution}
            </p>
            <p>{profile.education.major}</p>
            <p>Expected Graduation // {profile.education.expectedGraduation}</p>
            <p>{profile.education.academicFocus}</p>
          </div>
        </div>

        <TerminalTypewriter lines={profile.typewriterLines} prompt="SYS" />
      </div>
    </div>

    <aside class="space-y-4">
      <div class="border border-dossier-line/60 bg-dossier-panel/35 p-4">
        <div class="overflow-hidden border border-dossier-line/50 bg-dossier-ink-soft/80">
          <img
            src={profile.photo}
            alt={`${profile.subject} dossier portrait`}
            class="aspect-[4/5] w-full object-cover object-center grayscale contrast-125"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="mt-4 flex items-center justify-between gap-4 border-t border-dossier-line/50 pt-4 text-xs uppercase tracking-[0.18em] text-dossier-muted">
          <span>{profile.subject}</span>
          <span>{profile.clearance}</span>
        </div>
      </div>

      <div class="border border-dossier-line/60 bg-dossier-panel/30 p-4">
        <p class="dossier-kicker">Access Channels</p>
        <ul class="mt-4 space-y-3">
          {contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex items-start justify-between gap-4 border border-transparent px-0 py-1 text-sm text-dossier-muted transition hover:border-dossier-line/60 hover:bg-dossier-panel/40 hover:px-3"
              >
                <span class="uppercase tracking-[0.16em] text-dossier-paper">{link.label}</span>
                <span class="text-right transition group-hover:text-dossier-accent">{link.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</SectionFrame>
