---
import { projects } from '../../data/projects';
import SectionFrame from './SectionFrame.astro';
---

<SectionFrame
  eyebrow="Active Archive"
  title="Case Files"
  stamp="Project Dossiers"
  bodyClass="space-y-6"
>
  <div class="flex flex-col gap-3 border border-dossier-line/60 bg-dossier-panel/25 p-4 text-sm text-dossier-muted lg:flex-row lg:items-end lg:justify-between">
    <div class="space-y-2">
      <p class="dossier-kicker">File Index</p>
      <p>
        Current build records are catalogued as mission cases, with objectives, technical footprint, and
        operating status kept visible for rapid review.
      </p>
    </div>
    <p class="text-xs uppercase tracking-[0.18em] text-dossier-paper">Total Files // {projects.length}</p>
  </div>

  <div class="grid gap-5 xl:grid-cols-3">
    {projects.map((project) => (
      <article class="flex h-full flex-col border border-dossier-line/60 bg-dossier-panel/30 p-5">
        <div class="flex items-start justify-between gap-4 border-b border-dossier-line/50 pb-4">
          <div class="space-y-2">
            <p class="dossier-kicker">Case {project.id}</p>
            <h3 class="text-xl uppercase tracking-[0.14em] text-dossier-paper">{project.name}</h3>
          </div>
          <span class="shrink-0 border border-dossier-line/60 px-3 py-1 text-[11px] uppercase tracking-[0.18em] text-dossier-muted">
            {project.status}
          </span>
        </div>

        <div class="mt-5 flex flex-1 flex-col gap-5">
          <div class="space-y-2 text-sm leading-7 text-dossier-muted">
            <p class="dossier-kicker">Objective</p>
            <p>{project.objective}</p>
          </div>

          <div class="space-y-3">
            <p class="dossier-kicker">Technical Footprint</p>
            <ul class="flex flex-wrap gap-2">
              {project.stack.map((item) => (
                <li class="border border-dossier-line/60 bg-dossier-panel/30 px-3 py-2 text-xs uppercase tracking-[0.16em] text-dossier-paper">
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-auto border-t border-dossier-line/50 pt-4">
            <a
              href={project.href}
              class="group flex items-center justify-between gap-4 text-sm text-dossier-muted transition hover:text-dossier-accent"
            >
              <span class="uppercase tracking-[0.16em] text-dossier-paper">Open evidence</span>
              <span>{project.href.replace('https://', '')}</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</SectionFrame>
